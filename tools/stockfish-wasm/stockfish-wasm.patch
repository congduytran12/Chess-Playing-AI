+            }
+        }
+        
+        function processCommand(cmd)
+        {
+            cmd = cmd.trim();
+            /// Certain commands need to be blocked.
+            if (cmd.substring(0, 2) === "go" || cmd.substring(0, 9) === "setoption") {

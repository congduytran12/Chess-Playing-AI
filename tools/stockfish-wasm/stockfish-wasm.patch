+                        }
+                    }
+                    loadParts(enginePartsCount);
+                }
+                
+                var args = self.location.hash.substr(1).split(",");
+                wasmPath = decodeURIComponent(args[0] || location.origin + location.pathname.replace(/\.js$/i, ".wasm"));

+                                        progressPort.close();
+                                        progressPort = null;
+                                    }
+                                }, 4);
+                            }
+                        }
+                        
+                        function fetchWasmWithProgress(url, onProgress, onError)
+                        {
+                            return fetch(url).then(function onFetch(response)
+                            {
+                                var startTime = Date.now();
+                                
+                                if (!response.ok) {

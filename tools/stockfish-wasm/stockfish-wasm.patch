+                    }
+                    return Math.round(s / 60) + " min";
+                }
+                
+                function calcProgressData(loaded, total, startTime)
+                {
+                    /// To avoid dividing by zero, we round up to 1 ms.
+                    var elapsed = (Date.now() - startTime) || 1;

+                }
+                
+                function beginEngineInitialization(wasmBlob)
+                {
+                    engine = {
+                        locateFile: function (path)
+                        {
+                            if (path.indexOf(".wasm") > -1) {
+                                if (path.indexOf(".wasm.map") > -1) {
